<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text2</item>
        <item name="android:alertDialogTheme">@style/PintoDialog</item>
        <item name="android:dialogTheme">@style/PintoDialog</item>
    </style>

    <!-- einheitliche, abgerundete Dialoge im App-Design -->
    <style name="PintoDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text2</item>
        <item name="android:textColorAlertDialogListItem">@color/text</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:listSelector">@drawable/item_bg</item>
        <item name="android:buttonBarButtonStyle">@style/PintoDialogButton</item>
        <item name="android:windowMinWidthMajor">55%</item>
        <item name="android:windowMinWidthMinor">80%</item>
    </style>

    <style name="PintoDialogButton" parent="android:Widget.Material.Button.Borderless.Colored">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:background">@drawable/item_bg</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
    </style>
</resources>
