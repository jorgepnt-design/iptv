<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:use_controller="false"
        app:show_buffering="always"
        app:resize_mode="fit" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#CC000000"
        android:gravity="center"
        android:padding="20dp"
        android:textColor="@color/text"
        android:textSize="20sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/loadPane"
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#F2121620"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/loadTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/loadStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/text2"
            android:textSize="16sp" />

        <ProgressBar
            android:id="@+id/loadBar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="16dp"
            android:max="100"
            android:progressDrawable="@drawable/progress" />

        <TextView
            android:id="@+id/loadPercent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="end"
            android:textColor="@color/accent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/loadVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#66FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/epgChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:background="@drawable/label_bg"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:textColor="@color/text"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/versionTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp"
        android:textColor="@color/text3"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/recIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="24dp"
        android:background="@drawable/label_bg"
        android:elevation="30dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:textColor="#FF5252"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/numberEntry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="32dp"
        android:background="#CC000000"
        android:paddingHorizontal="24dp"
        android:paddingVertical="8dp"
        android:textColor="@color/text"
        android:textSize="48sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Timeshift-Leiste -->
    <LinearLayout
        android:id="@+id/tsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="140dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/card_bg"
        android:elevation="9dp"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/tsProgress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginVertical="4dp"
            android:max="1000"
            android:progressDrawable="@drawable/progress" />

        <TextView
            android:id="@+id/tsHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏯ Pause/Weiter  ·  ◀ 10 s zurück  ·  ▶ 30 s vor  ·  Zurück = Live"
            android:textColor="@color/text3"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Info-Leiste unten beim Umschalten -->
    <LinearLayout
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="140dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/card_bg"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="78dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="78dp"
                android:layout_height="44dp"
                android:background="@drawable/logo_bg"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/bannerLogo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <TextView
                android:id="@+id/bannerNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/bannerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/bannerBadges"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/text2"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/bannerGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/text3"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/bannerNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/bannerProgress"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progressDrawable="@drawable/progress" />

                <TextView
                    android:id="@+id/bannerRemaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/text2"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/bannerNext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text3"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="14dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/bannerClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bannerDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text3"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Kanalliste (TiviMate-Stil): Menü | Gruppen | Kanäle | Details -->
    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/overlay_bg"
        android:orientation="horizontal"
        android:paddingVertical="24dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/menuPane"
            android:layout_width="250dp"
            android:layout_height="match_parent"
            android:background="@color/surface"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/pinto_logo" />

                <TextView
                    android:id="@+id/menuTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:letterSpacing="0.02"
                    android:text="@string/app_name"
                    android:textColor="@color/text"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/menuList"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/groupList"
            android:layout_width="230dp"
            android:layout_height="match_parent"
            android:paddingHorizontal="8dp"
            android:clipToPadding="false" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/channelList"
            android:layout_width="390dp"
            android:layout_height="match_parent"
            android:paddingHorizontal="8dp"
            android:clipToPadding="false" />

        <LinearLayout
            android:id="@+id/detailPane"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/overlayVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/text3"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/clock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/text"
                android:textSize="22sp" />

            <View
                android:id="@+id/previewSlot"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/detailLogo"
                    android:layout_width="56dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/logo_tile"
                    android:padding="4dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/detailChannel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="@color/accent"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/detailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detailTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text2"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/detailDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:maxLines="5"
                android:textColor="@color/text2"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/detailNext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/text3"
                android:textSize="15sp" />

            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

            <TextView
                android:id="@+id/hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OK: Vorschau · nochmal OK: Vollbild · OK lang: Favoriten / Multi-View · ← Menü"
                android:textColor="@color/text3"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
